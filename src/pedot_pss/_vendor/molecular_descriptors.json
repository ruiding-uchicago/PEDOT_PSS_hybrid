  "methods": {
    "hba": {
      "call": "rdkit.Chem.Lipinski.NumHAcceptors(mol)",
      "meaning": "RDKit hydrogen-bond acceptor count, not NOCount",
      "source_url": "https://www.rdkit.org/docs/source/rdkit.Chem.Lipinski.html#rdkit.Chem.Lipinski.NumHAcceptors",
      "unit": "count"
    },
    "hbd": {
      "call": "rdkit.Chem.Lipinski.NumHDonors(mol)",
      "meaning": "RDKit hydrogen-bond donor count, not NHOHCount",
      "source_url": "https://www.rdkit.org/docs/source/rdkit.Chem.Lipinski.html#rdkit.Chem.Lipinski.NumHDonors",
      "unit": "count"
    },
    "mol_logp": {
      "call": "rdkit.Chem.Crippen.MolLogP(mol, includeHs=True, force=True)",
      "meaning": "Wildman-Crippen atom-fragment model LogP; negative values allowed, not a measured partition coefficient",
      "source_url": "https://www.rdkit.org/docs/source/rdkit.Chem.Crippen.html#rdkit.Chem.Crippen.MolLogP",
      "unit": "dimensionless"
    },
    "mol_wt": {
      "call": "rdkit.Chem.Descriptors.MolWt(mol)",
      "meaning": "Average molecular weight including implicit hydrogen, not exact isotopic mass",
      "source_url": "https://www.rdkit.org/docs/source/rdkit.Chem.Descriptors.html#rdkit.Chem.Descriptors.MolWt",
      "unit": "Da (numerically g/mol)"
    },
    "tpsa": {
      "call": "rdkit.Chem.rdMolDescriptors.CalcTPSA(mol, force=True, includeSandP=False)",
      "includeSandP": false,
      "meaning": "RDKit default Ertl-style topological polar surface area: N/O contributions only, explicitly excluding S/P contributions",
      "source_url": "https://www.rdkit.org/docs/RDKit_Book.html#implementation-of-the-tpsa-descriptor",
      "unit": "angstrom^2"
    }
  },
  "rdkit_version": "2025.03.5",
  "rules": {
    "aggregation": "Equal-weight identity-set arithmetic mean and max-minus-min span separately for recipe/post; no doses or frequency weights",
